{
  "name": "pdf-to-bijoy-backend",
  "version": "1.0.0",
  "description": "Backend for PDF to Bijoy Converter - extracts Bengali text from PDFs and converts Unicode to Bijoy/SutonnyMJ encoding",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "ts-node src/converter/unicodeToBijoy.test.ts"
  },
  "dependencies": {
    "@codesigntheory/bnunicode2ansi": "^1.6.1",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "docx": "^9.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "fast-xml-parser": "^5.11.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@codesigntheory/bnbijoy2unicode": "^1.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.9",
    "@types/uuid": "^9.0.8",
    "nodemon": "^3.1.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
