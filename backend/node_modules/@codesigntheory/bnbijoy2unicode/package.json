{
  "name": "@codesigntheory/bnbijoy2unicode",
  "version": "1.3.0",
  "description": "A Typescript library to convert bijoy text to unicode",
  "repository": "github:codesigntheory/bnbijoytounicode",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "test": "jest"
  },
  "keywords": [
    "Bengali",
    "Bijoy",
    "ANSI",
    "Unicode",
    "TextConverter"
  ],
  "author": "Utsob Roy",
  "devDependencies": {
    "@types/jest": "^24.0.11",
    "babel-jest": "^24.5.0",
    "jest": "^24.5.0",
    "ts-jest": "^24.0.1",
    "typescript": "^3.4.1"
  },
  "jest": {
    "transform": {
      "^.+\\.js?$": "babel-jest",
      "^.+\\.ts?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "js"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js"
  ]
}
