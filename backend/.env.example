# Port the server listens on.
# Render injects PORT automatically — leave this as 4000 or omit it.
PORT=4000

# Comma-separated list of allowed CORS origins.
#
# *.vercel.app preview URLs and localhost are ALREADY allowed automatically
# (see src/index.ts). You only need to set this for:
#   - A custom production domain (e.g. https://bijoy.example.com)
#   - Your specific Vercel production URL if it is NOT on *.vercel.app
#
# Example (replace with your real Vercel URL):
#   CORS_ORIGIN=https://pdf-to-bijoy-converter.vercel.app
#
# Multiple origins (comma-separated):
#   CORS_ORIGIN=https://pdf-to-bijoy-converter.vercel.app,https://bijoy.example.com
CORS_ORIGIN=http://localhost:5173
