# URL of the backend API server.
#
# Development: leave as http://localhost:4000 (or omit the file entirely —
# the frontend auto-detects localhost and falls back to port 4000).
#
# Production (Vercel): set this to your Render backend service URL.
# Example:
#   VITE_API_BASE_URL=https://pdf-to-bijoy-backend.onrender.com
#
# ⚠️  This env var is baked into the static JS bundle at build time by Vite.
#    You must set it in the Vercel project's "Environment Variables" settings
#    (not just a local .env file), and re-deploy after changing it.
VITE_API_BASE_URL=http://localhost:4000
